#!/usr/bin/env python3
"""hivemind board command line interface."""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

THRESHOLD = 3
CORE_TOPICS = ["stack", "code-style", "architecture", "testing", "workflow", "communication"]
KINDS = ["decision", "lesson", "preference", "inspiration", "observation", "question"]
PROTECTED_FALLBACK = ("main", "master")
DEFAULT_REMOTE = "origin"

KEY_RE = re.compile(r"^([A-Za-z][A-Za-z0-9_-]*): (.*)$")
BARE_KEY_RE = re.compile(r"^([A-Za-z][A-Za-z0-9_-]*):$")
FOLDED_VALUES = {"|", ">", "|-", ">-", "|+", ">+", "|2", ">2"}
ID_RE = re.compile(r"^\d{8}-\d{4}-[a-z0-9-]+$")
ADR_RE = re.compile(r"^(\d+)-")
ROW_ID_RE = re.compile(r"^\|\s*(\d{8}-\d{4}-[a-z0-9-]+)")
INDEX_HEADER = "<!-- Generated file — do not edit -->"
ROW_HEADER = "| title | kind | score | project links |"
ROW_SEP = "| --- | --- | --- | --- |"


class GitError(Exception):
    pass


class PostError(Exception):
    pass


def emit(msg: str = "") -> None:
    print(msg)


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    sys.exit(code)


def board_path() -> Path:
    env = os.environ.get("HIVEMIND_BOARD")
    if env:
        return Path(env)
    return Path(__file__).resolve().parent


def _as_list(value) -> list:
    if value is None:
        return []
    if isinstance(value, str):
        return [value] if value else []
    return list(value)


def _slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:48].strip("-")


def _parse_value(raw: str, where: str):
    if raw == "-":
        return ""
    if raw in FOLDED_VALUES:
        raise PostError(f"{where}: multi-line/folded scalars are not supported")
    if re.match(r"^\[.*\]$", raw):
        inner = raw[1:-1].strip()
        if not inner:
            return []
        return [part.strip() for part in inner.split(",")]
    if raw != raw.strip():
        raise PostError(f"{where}: leading/trailing whitespace in value")
    return raw


def _parse(text: str, where: str) -> tuple:
    lines = text.split("\n")
    if not lines or lines[0] != "---":
        raise PostError(f"{where}: missing opening --- frontmatter delimiter")
    meta = {}
    index = 1
    closed = False
    while index < len(lines):
        line = lines[index]
        if line == "---":
            closed = True
            index += 1
            break
        if line[:1] in (" ", "\t"):
            kind = "tab indentation" if line[:1] == "\t" else "indented line"
            raise PostError(
                f"{where}:{index + 1}: {kind} in frontmatter "
                "(nested maps and multi-line scalars are not supported)"
            )
        if line == "":
            raise PostError(f"{where}:{index + 1}: empty line in frontmatter")
        match = KEY_RE.match(line)
        if not match:
            bare = BARE_KEY_RE.match(line)
            if bare:
                raise PostError(
                    f"{where}:{index + 1}: key '{bare.group(1)}' has no value "
                    "(nested maps are not supported)"
                )
            raise PostError(
                f"{where}:{index + 1}: malformed frontmatter line, expected 'key: value'"
            )
        key = match.group(1)
        if key in meta:
            raise PostError(f"{where}:{index + 1}: duplicate key '{key}'")
        try:
            meta[key] = _parse_value(match.group(2), f"{where}:{index + 1}")
        except PostError as exc:
            raise PostError(str(exc)) from None
        index += 1
    if not closed:
        raise PostError(f"{where}: missing closing --- frontmatter delimiter")
    body_lines = lines[index:]
    for offset, line in enumerate(body_lines):
        if line == "---":
            for later in body_lines[offset + 1:]:
                if KEY_RE.match(later) or BARE_KEY_RE.match(later):
                    raise PostError(f"{where}: frontmatter key found after body started")
            break
    return meta, "\n".join(body_lines)


def load_post(path: Path) -> tuple:
    path = Path(path)
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        die(f"cannot read {path}: {exc}")
    try:
        return _parse(text, str(path))
    except PostError as exc:
        die(str(exc))


def _dump_value(value) -> str:
    if value is None:
        return "-"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(str(item) for item in value) + "]"
    text = str(value)
    if "\n" in text:
        die("cannot dump a multi-line scalar value")
    if text == "":
        return "-"
    return text


def dump_post(meta: dict, body: str) -> str:
    lines = ["---"]
    for key, value in meta.items():
        if not re.match(r"^[A-Za-z][A-Za-z0-9_-]*$", str(key)):
            die(f"cannot dump frontmatter key '{key}'")
        lines.append(f"{key}: {_dump_value(value)}")
    lines.append("---")
    return "\n".join(lines) + "\n" + body


def make_id(title: str, now: datetime) -> str:
    slug = _slug(title)
    if not slug:
        die("title produces an empty slug")
    return f"{now.strftime('%Y%m%d-%H%M')}-{slug}"


def next_adr_number() -> int:
    decisions = board_path() / "decisions"
    highest = 0
    if decisions.is_dir():
        for path in decisions.glob("*.md"):
            match = ADR_RE.match(path.name)
            if match:
                highest = max(highest, int(match.group(1)))
    return highest + 1


def run_git(*args, cwd=None, check=True) -> subprocess.CompletedProcess:
    proc = subprocess.run(
        ["git", *args],
        cwd=str(cwd) if cwd else str(board_path()),
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        head = f"git {' '.join(args)} failed"
        if not check:
            return proc
        raise GitError(f"{head}: {detail}" if detail else head)
    return proc


def _current_branch() -> str:
    return run_git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()


def push_or_stop(remote: str = DEFAULT_REMOTE) -> None:
    """Push the current branch. Never rebase on the user's behalf.

    A rejected push is reported, never papered over: silently rebasing rewrites
    local history the user has not looked at yet, on a branch that may be the
    protected default.
    """
    try:
        run_git("push")
    except GitError as exc:
        branch = _current_branch()
        die(
            f"{exc}\n"
            f"Nothing was rebased and nothing was discarded — the commit is local to "
            f"'{branch}'. To publish it, rebase deliberately and push again:\n"
            f"  git pull --rebase {remote} {branch} && git push",
            code=2,
        )


def _stream_posts() -> list:
    stream = board_path() / "stream"
    if not stream.is_dir():
        return []
    posts = []
    for path in sorted(stream.glob("*.md")):
        meta, body = load_post(path)
        posts.append((path, meta, body))
    return posts


def _index_row(meta: dict) -> str:
    title = str(meta.get("title", "")).replace("|", "\\|")
    kind = str(meta.get("kind", ""))
    score = str(meta.get("endorsements", "0"))
    links = ", ".join(
        f"[{name}](by-project.md#{_slug(name)})"
        for name in _as_list(meta.get("projects"))
    )
    return f"| {title} | {kind} | {score} | {links} |"


def _write_groups(path: Path, heading: str, groups: dict) -> None:
    lines = [INDEX_HEADER, "", heading, ""]
    for name in sorted(groups):
        lines.append(f"## {name}")
        lines.append("")
        lines.append(ROW_HEADER)
        lines.append(ROW_SEP)
        lines.extend(groups[name])
        lines.append("")
    path.write_text("\n".join(lines).rstrip("\n") + "\n", encoding="utf-8")


def regen_index() -> None:
    posts = _stream_posts()
    by_topic: dict = {}
    by_project: dict = {}
    for _, meta, _ in posts:
        row = _index_row(meta)
        for topic in _as_list(meta.get("topics")):
            by_topic.setdefault(topic, []).append(row)
        for project in _as_list(meta.get("projects")):
            by_project.setdefault(project, []).append(row)
    index = board_path() / "index"
    index.mkdir(parents=True, exist_ok=True)
    _write_groups(index / "by-topic.md", "# By topic", by_topic)
    _write_groups(index / "by-project.md", "# By project", by_project)
    rows = sorted(
        ((_index_row(meta), str(meta.get("id", ""))) for _, meta, _ in posts),
        key=lambda pair: pair[1],
        reverse=True,
    )
    lines = [INDEX_HEADER, "", "# New", "", ROW_HEADER, ROW_SEP]
    lines.extend(row for row, _ in rows)
    lines.append("")
    (index / "new.md").write_text("\n".join(lines), encoding="utf-8")


def _split_csv(raw: str) -> list:
    return [part.strip() for part in raw.split(",") if part.strip()]


def _read_body(arg) -> str:
    if arg is None:
        return ""
    if arg == "-":
        return sys.stdin.read()
    path = Path(arg)
    if not path.is_file():
        die(f"body file not found: {arg}")
    return path.read_text(encoding="utf-8")


def _set_upstream(remote: str) -> None:
    """Track the same-named remote branch, but only if nothing is tracked yet.

    Overwriting an existing upstream would silently retarget a branch the user
    pointed at a different remote branch on purpose.
    """
    branch = _current_branch()
    if run_git("config", "--get", f"branch.{branch}.merge", check=False).stdout.strip():
        return
    run_git("config", f"branch.{branch}.remote", remote)
    run_git("config", f"branch.{branch}.merge", f"refs/heads/{branch}")


def _remote_default_branch(remote: str) -> str:
    try:
        ref = run_git(
            "symbolic-ref", "--quiet", "--short", f"refs/remotes/{remote}/HEAD"
        ).stdout.strip()
    except GitError:
        return ""
    return ref.split("/", 1)[-1] if "/" in ref else ""


def _require_feature_branch(remote: str, action: str) -> str:
    """Refuse to write on the protected default branch.

    ADR 0049 makes the default branch PR-only. hm writes straight to whatever
    branch it is on, so the guard has to live here or nowhere.
    """
    branch = _current_branch()
    if branch in ("", "HEAD"):
        die(f"cannot {action} from a detached HEAD; check out a branch first", code=4)
    # refs/remotes/<remote>/HEAD goes stale when a remote renames its default
    # branch, and git fetch never refreshes it. Union the detected default with
    # the fallback names so a stale symref can only add protection.
    protected = set(PROTECTED_FALLBACK)
    default = _remote_default_branch(remote)
    if default:
        protected.add(default)
    if branch in protected:
        die(
            f"'{branch}' is the default branch and is protected — cannot {action} "
            f"directly.\n"
            f"Every change reaches the default branch through a pull request:\n"
            f"  git switch -c post/<slug> && ./hm {action}",
            code=4,
        )
    return branch


def _gh_available() -> bool:
    return shutil.which("gh") is not None


def _gh(*args) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["gh", *args], cwd=str(board_path()), capture_output=True, text=True
    )


def _default_branch(remote: str) -> str:
    return _remote_default_branch(remote) or PROTECTED_FALLBACK[0]


def _pr_number(url: str):
    match = re.search(r"/pull/(\d+)", url)
    return int(match.group(1)) if match else None


def _find_open_pr(branch: str):
    if not _gh_available():
        return None
    view = _gh("pr", "view", branch, "--json", "number,url,state")
    if view.returncode != 0:
        return None
    try:
        data = json.loads(view.stdout)
    except ValueError:
        return None
    return data if data.get("state") == "OPEN" else None


def _pr_hint(remote: str, branch: str, title: str) -> str:
    return (
        f"  gh pr create --base {_default_branch(remote)} --head {branch} "
        f"--title {shlex.quote(f'post: {title}')}"
    )


def _open_pr(remote: str, branch: str, title: str, body: str):
    """Open a PR for the pushed branch, or reuse the open one. None if gh can't."""
    existing = _find_open_pr(branch)
    if existing:
        emit(f"PR {existing.get('url')} is already open")
        return existing
    if not _gh_available():
        print(
            "gh not found — the post is pushed but no PR was opened.\n"
            "Open one with:\n" + _pr_hint(remote, branch, title),
            file=sys.stderr,
        )
        return None
    create = _gh(
        "pr", "create",
        "--base", _default_branch(remote),
        "--head", branch,
        "--title", f"post: {title}",
        "--body", body,
    )
    if create.returncode != 0:
        detail = (create.stderr or create.stdout).strip()
        print(
            f"could not open a PR: {detail}\nOpen one with:\n"
            + _pr_hint(remote, branch, title),
            file=sys.stderr,
        )
        return None
    url = create.stdout.strip().splitlines()[-1] if create.stdout.strip() else ""
    number = _pr_number(url)
    if number is None:
        return _find_open_pr(branch)
    emit(f"opened PR {url}")
    return {"number": number, "url": url, "state": "OPEN"}


def _merge_pr(target):
    proc = _gh("pr", "merge", str(target), "--rebase")
    if proc.returncode != 0:
        return False, (proc.stderr or proc.stdout).strip()
    return True, ""


def _return_to_default(remote: str, branch: str) -> None:
    default = _default_branch(remote)
    try:
        run_git("switch", default)
    except GitError as exc:
        print(f"merged, but could not switch to {default}: {exc}", file=sys.stderr)
        return
    pull = run_git("pull", "--rebase", check=False)
    if pull.returncode != 0:
        detail = (pull.stderr or pull.stdout).strip()
        print(f"merged, but could not update {default}: {detail}", file=sys.stderr)
    run_git("branch", "-D", branch, check=False)


def _merge_posted_pr(remote: str, branch: str, pr: dict) -> None:
    number = pr["number"]
    ok, detail = _merge_pr(number)
    if not ok:
        print(
            f"could not merge PR #{number}: {detail}\n"
            f"It is still open at {pr.get('url')}. Retry with: ./hm merge {number}",
            file=sys.stderr,
        )
        return
    emit(f"merged PR #{number} into {_default_branch(remote)}")
    _return_to_default(remote, branch)


def _post_path(pid: str) -> Path:
    if pid.endswith(".md"):
        pid = pid[:-3]
    return board_path() / "stream" / f"{pid}.md"


def _inbox_path() -> Path:
    return board_path() / "queue" / "inbox.md"


def _cell(text: str) -> str:
    return str(text).replace("\\|", "|").strip()


def _inbox_rows() -> list:
    path = _inbox_path()
    if not path.is_file():
        return []
    rows = []
    for line in path.read_text(encoding="utf-8").splitlines():
        match = ROW_ID_RE.match(line)
        if not match:
            continue
        cells = [_cell(part) for part in line.strip().strip("|").split("|")]
        if len(cells) >= 4:
            rows.append(cells)
    return rows


def _inbox_append(meta: dict) -> None:
    path = _inbox_path()
    row = (
        f"| {meta.get('id', '')} | {str(meta.get('title', '')).replace('|', '\\|')} "
        f"| {meta.get('endorsements', 0)} | {', '.join(_as_list(meta.get('projects')))} |"
    )
    if path.is_file():
        text = path.read_text(encoding="utf-8")
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        text = "# Queue\n\n" + ROW_HEADER + "\n" + ROW_SEP + "\n"
    if text and not text.endswith("\n"):
        text += "\n"
    path.write_text(text + row + "\n", encoding="utf-8")


def _inbox_drop(ids: list) -> None:
    path = _inbox_path()
    if not path.is_file():
        return
    keep = []
    for line in path.read_text(encoding="utf-8").splitlines():
        match = ROW_ID_RE.match(line)
        if match and match.group(1) in ids:
            continue
        keep.append(line)
    path.write_text("\n".join(keep) + "\n", encoding="utf-8")


def _append_ratified(entries: list) -> None:
    path = board_path() / "queue" / "ratified.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.is_file():
        path.write_text("# Ratified\n\n", encoding="utf-8")
    text = path.read_text(encoding="utf-8")
    if text and not text.endswith("\n"):
        text += "\n"
    date_str = datetime.now().strftime("%Y-%m-%d")
    lines = [f"- {date_str} | {pid} | ADR {number:04d}" for pid, number in entries]
    path.write_text(text + "\n".join(lines) + "\n", encoding="utf-8")


def _pick_topic(meta: dict, core_file) -> str:
    for topic in _as_list(meta.get("topics")):
        if topic in CORE_TOPICS:
            return topic
    if core_file:
        if core_file in CORE_TOPICS:
            return core_file
        die(f"--core-file must be one of {', '.join(CORE_TOPICS)}")
    die(
        f"post {meta.get('id')} has no topic in CORE_TOPICS "
        f"({', '.join(CORE_TOPICS)}); re-run with --core-file <topic>"
    )


def cmd_post(args) -> None:
    if args.kind not in KINDS:
        die(f"--kind must be one of {', '.join(KINDS)}")
    topics = _split_csv(args.topics)
    projects = _split_csv(args.projects)
    if not topics:
        die("at least one --topics value is required")
    if not projects:
        die("at least one --projects value is required")
    try:
        run_git("remote", "get-url", args.remote)
    except GitError:
        die(f"unknown git remote '{args.remote}'; pass --remote <remote name>")
    _require_feature_branch(args.remote, "post")
    branch = _current_branch()
    body = _read_body(args.body)
    now = datetime.now().astimezone()
    pid = make_id(args.title, now)
    path = _stream_posts_path(pid)
    if path.exists():
        die(f"post {pid} already exists")
    if run_git("status", "--porcelain").stdout.strip():
        die("board has uncommitted changes; refusing to post")
    meta = {
        "id": pid,
        "title": args.title,
        "kind": args.kind,
        "topics": topics,
        "projects": projects,
        "origin": os.environ.get("HIVEMIND_ORIGIN") or args.origin,
        "posted": now.isoformat(timespec="minutes"),
        "endorsements": 0,
        "status": "stream",
        "promoted-to": "-",
        "supersedes": "-",
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(dump_post(meta, body), encoding="utf-8")
    run_git("add", "--", str(path))
    run_git("commit", "-m", f"post: {args.title}")
    _set_upstream(args.remote)
    push_or_stop(args.remote)
    if not args.no_pr:
        pr = _open_pr(args.remote, branch, args.title, _pr_body(meta))
        if pr:
            if args.no_merge:
                emit(
                    f"PR {pr['url']} left open; merge it with: ./hm merge {pr['number']}"
                )
            else:
                _merge_posted_pr(args.remote, branch, pr)
    emit(f"posted {pid}")


def _pr_body(meta: dict) -> str:
    topics = ", ".join(str(topic) for topic in _as_list(meta.get("topics")))
    projects = ", ".join(str(project) for project in _as_list(meta.get("projects")))
    return (
        "Posted with hm.\n\n"
        f"- id: {meta.get('id')}\n"
        f"- kind: {meta.get('kind')}\n"
        f"- topics: {topics}\n"
        f"- projects: {projects}"
    )


def cmd_merge(args) -> None:
    targets = list(args.targets)
    if not targets and not args.all:
        die("give a PR number or branch, or --all")
    if not _gh_available():
        die("gh not found; install the GitHub CLI to merge PRs")
    prs = []
    if args.all:
        listing = _gh("pr", "list", "--json", "number,headRefName", "--limit", "100")
        if listing.returncode != 0:
            die(f"could not list PRs: {(listing.stderr or listing.stdout).strip()}")
        try:
            for item in json.loads(listing.stdout or "[]"):
                prs.append((item["number"], item.get("headRefName", "")))
        except (ValueError, KeyError, TypeError) as exc:
            die(f"could not read the PR list: {exc}")
    for target in targets:
        prs.append((target, ""))
    if not prs:
        emit("no open PRs")
        return
    failures = 0
    for number, branch in prs:
        ok, detail = _merge_pr(number)
        if ok:
            emit(f"merged #{number} {branch}".rstrip())
        else:
            failures += 1
            print(
                f"could not merge #{number} {branch}: {detail}".rstrip(),
                file=sys.stderr,
            )
    if failures:
        die(f"{failures} of {len(prs)} PR(s) not merged")


def _stream_posts_path(pid: str) -> Path:
    return board_path() / "stream" / f"{pid}.md"


def cmd_status(args) -> None:
    try:
        last = run_git("log", "-1", "--format=%cI").stdout.strip()
    except GitError:
        last = "none"
    dirty = sum(
        1 for line in run_git("status", "--porcelain").stdout.splitlines() if line.strip()
    )
    posts = _stream_posts()
    queued = [meta for _, meta, _ in posts if meta.get("status") == "queued"]
    recent = sorted(posts, key=lambda item: str(item[1].get("id", "")), reverse=True)[:3]
    emit(f"last commit: {last}")
    emit(f"dirty files: {dirty}")
    emit(f"queue depth: {len(queued)}")
    emit("recent posts:")
    for _, meta, _ in recent:
        emit(f"  {meta.get('id')} {meta.get('title')}")


def cmd_endorse(args) -> None:
    _require_feature_branch(DEFAULT_REMOTE, "endorse")
    path = _post_path(args.id)
    if not path.is_file():
        die(f"no such post: {args.id}")
    meta, body = load_post(path)
    try:
        count = int(meta.get("endorsements", "0"))
    except (TypeError, ValueError):
        die(f"post {meta.get('id')} has a bad endorsements value")
    count += 1
    meta["endorsements"] = count
    queued = False
    if meta.get("kind") != "question" and count >= THRESHOLD and meta.get("status") == "stream":
        meta["status"] = "queued"
        _inbox_append(meta)
        queued = True
    path.write_text(dump_post(meta, body), encoding="utf-8")
    run_git("add", "--", str(path))
    if queued:
        run_git("add", "--", str(_inbox_path()))
    run_git("commit", "-m", f"endorse: {meta.get('id')}")
    _set_upstream(DEFAULT_REMOTE)
    push_or_stop()
    emit(f"endorsed {meta.get('id')} ({count}) -> {meta.get('status')}")


def cmd_queue(args) -> None:
    rows = _inbox_rows()
    if not rows:
        emit("queue is empty")
        return
    for cells in reversed(rows):
        emit(" | ".join(cells[:4]))


def _collect_targets(args) -> list:
    if args.all:
        return [
            str(meta.get("id"))
            for _, meta, _ in _stream_posts()
            if meta.get("status") == "queued"
        ]
    if not args.id:
        die("ratify requires --all or an <id>")
    path = _post_path(args.id)
    if not path.is_file():
        die(f"no such post: {args.id}")
    return [path.stem]


def _demote_headings(body: str) -> str:
    lines = []
    in_fence = False
    for line in body.splitlines():
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            lines.append(line)
            continue
        if not in_fence and re.match(r"^#{1,5} ", line):
            lines.append("#" + line)
            continue
        lines.append(line)
    return "\n".join(lines)


def _ratify_section(body: str, existing: str, slug: str, title: str = "") -> str:
    if existing and not existing.endswith("\n"):
        separator = "\n\n"
    elif existing:
        separator = "\n"
    else:
        separator = ""
    heading = (title or slug.replace("-", " ")).strip()
    return separator + f"## {heading}\n\n" + _demote_headings(body.strip()) + "\n"


def _split_post_sections(body: str) -> tuple[str, str, str]:
    headings = ("what i hit", "what we decided", "why", "the cost")
    parts: dict[str, list[str]] = {h: [] for h in headings}
    current = None
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith("#"):
            heading = stripped.lstrip("#").strip().lower().rstrip(":")
            if heading in parts:
                current = heading
                continue
        if current:
            parts[current].append(line)
    context = "\n\n".join(
        chunk for chunk in ("\n".join(parts["what i hit"]).strip(), "\n".join(parts["why"]).strip()) if chunk
    )
    return context, "\n".join(parts["what we decided"]).strip(), "\n".join(parts["the cost"]).strip()


def _adr_text(meta: dict, body: str, number: int, date_str: str) -> str:
    title = str(meta.get("title", "")).strip()
    sentence = title[:1].upper() + title[1:]
    affects = ", ".join(_as_list(meta.get("projects")))
    context, decision, consequences = _split_post_sections(body)
    if not context:
        context = body.strip()
    return (
        f"# {number:04d}. {sentence}\n"
        f"**Status:** accepted\n"
        f"**Date:** {date_str}\n"
        f"**Affects:** {affects}\n\n"
        f"## Context\n\n{context}\n\n"
        f"## Decision\n\n{decision or '-'}\n\n"
        f"## Consequences\n\n{consequences or '-'}\n"
    )


def _ratify_apply(resolved: list, tmp: Path) -> None:
    board = board_path()
    date_str = datetime.now().strftime("%Y-%m-%d")
    entries = []
    for pid, meta, body, topic in resolved:
        slug = _slug(str(meta.get("title", "")))
        core_path = board / "core" / f"{topic}.md"
        if core_path.is_file():
            shutil.copy2(core_path, tmp / core_path.name)
        existing = core_path.read_text(encoding="utf-8") if core_path.is_file() else ""
        core_path.parent.mkdir(parents=True, exist_ok=True)
        with core_path.open("a", encoding="utf-8") as handle:
            handle.write(_ratify_section(body, existing, slug, str(meta.get("title", ""))))
        number = next_adr_number()
        adr_path = board / "decisions" / f"{number:04d}-{slug}.md"
        adr_path.parent.mkdir(parents=True, exist_ok=True)
        adr_path.write_text(_adr_text(meta, body, number, date_str), encoding="utf-8")
        meta["status"] = "promoted"
        meta["promoted-to"] = f"core/{topic}.md#{slug}"
        _post_path(pid).write_text(dump_post(meta, body), encoding="utf-8")
        entries.append((pid, number))
    _inbox_drop([pid for pid, _ in entries])
    _append_ratified(entries)
    regen_index()
    run_git("add", "-A")
    run_git("commit", "-m", f"ratify: {len(resolved)} post(s)")
    _set_upstream(DEFAULT_REMOTE)
    # deliberately not push_or_stop: the rollback below discards this commit, so
    # the handler must report the push failure, not advise pushing it again.
    run_git("push")


def _rollback(sha: str, tmp: Path) -> None:
    run_git("checkout", "--", ".")
    shutil.rmtree(tmp, ignore_errors=True)
    run_git("reset", "--hard", sha)
    run_git("clean", "-fd")
    for name in ("core", "stream", "queue", "decisions", "index"):
        (board_path() / name).mkdir(parents=True, exist_ok=True)


def cmd_ratify(args) -> None:
    _require_feature_branch(DEFAULT_REMOTE, "ratify")
    targets = _collect_targets(args)
    if not targets:
        emit("nothing to ratify")
        return
    resolved = []
    for pid in targets:
        path = _stream_posts_path(pid)
        meta, body = load_post(path)
        resolved.append((pid, meta, body, _pick_topic(meta, args.core_file)))
    sha = run_git("rev-parse", "HEAD").stdout.strip()
    tmp = board_path() / ".hivemind-tmp"
    try:
        tmp.mkdir(parents=True, exist_ok=True)
        _ratify_apply(resolved, tmp)
    except (Exception, SystemExit) as exc:
        # SystemExit is a BaseException, not an Exception: die() from dump_post
        # would otherwise escape and leave core/ rewritten but unpublished.
        reason = str(exc).strip() or "the ratification could not be completed"
        detail = ""
        try:
            _rollback(sha, tmp)
        except Exception as rollback_exc:
            detail = f" (rollback error: {rollback_exc})"
        die(f"ratification rolled back to {sha}; core untouched: {reason}{detail}", code=3)
    emit(f"ratified {len(resolved)} post(s) into core/")


def _anchor(heading: str) -> str:
    """The GitHub-style fragment for a heading: lowercase, non-alphanumerics to hyphens."""
    return re.sub(r"[^a-z0-9]+", "-", heading.lower()).strip("-")


def _section_end(lines: list, start: int) -> int:
    for index in range(start + 1, len(lines)):
        if lines[index].startswith("## "):
            return index
    return len(lines)


def _find_core_section(path: Path, slug: str):
    """Locate a `## ` section by either slug form. Returns (lines, start, end) or None."""
    if not path.is_file():
        return None
    lines = path.read_text(encoding="utf-8").split("\n")
    for index, line in enumerate(lines):
        if not line.startswith("## "):
            continue
        heading = line[3:].strip()
        if slug in (_anchor(heading), _slug(heading)):
            return lines, index, _section_end(lines, index), heading
    return None


def _find_adr(number: str):
    if not re.match(r"^\d{3,4}$", number):
        return None
    matches = sorted((board_path() / "decisions").glob(f"{number}-*.md"))
    return matches[0] if matches else None


def _core_anchors(path: Path) -> set:
    """Every heading anchor still living in the core file, at any depth.

    A withdrawn section can link to a `###` inside a section that survived, so
    subheadings count too — GitHub resolves `#anchor` against any heading level.
    """
    if not path.is_file():
        return set()
    anchors = set()
    for line in path.read_text(encoding="utf-8").split("\n"):
        if re.match(r"^#{1,6} ", line):
            anchors.add(_anchor(re.sub(r"^#{1,6} ", "", line).strip()))
    return anchors


def _repair_fragments(text: str, live_anchors: set, topic: str) -> str:
    """Re-point `#anchor` links at core/, where the live headings now live.

    A fragment-only link inside a moved section resolves against the file it sits
    in. Once the section is in archive/ its targets are in core/, so the link has
    to name that file. Fragments with no matching heading are left alone rather
    than rewritten into something that also does not resolve.
    """

    def replace(match):
        anchor = match.group(1)
        target = f"../core/{topic}.md#{anchor}" if anchor in live_anchors else match.group(0)
        return f"]({target})"

    return re.sub(r"\]\(#([a-z0-9\-]+)\)", replace, text)


def _archive_body(heading: str, section: list, adr_name: str, note, date_str: str) -> str:
    body = "\n".join(section[1:]).strip("\n")
    lines = [f"## {heading}", ""]
    lines.append(
        f"**Withdrawn** {date_str} by [ADR {adr_name}](../decisions/{adr_name})."
    )
    if note:
        lines.append("")
        lines.append(note.strip())
    if body:
        lines.extend(["", body])
    return "\n".join(lines)


NUMBER_WORDS = (
    "zero", "one", "two", "three", "four", "five",
    "six", "seven", "eight", "nine", "ten",
)
_COUNT_RE = re.compile(
    r"\b(\d+|" + "|".join(NUMBER_WORDS) + r")\b", re.IGNORECASE
)


def _match_case(sample: str, word: str) -> str:
    if sample.isupper():
        return word.upper()
    if sample[:1].isupper():
        return word.capitalize()
    return word


def _retitle_count(lines: list, list_start: int, was: int, now: int) -> None:
    """Fix a heading whose count this removal invalidated, and nothing else.

    Removing a bullet can leave "The five that matter most" heading a list of
    four. That heading is only ours to rewrite when its count matched the list
    before the removal; a heading that was already wrong stays wrong rather than
    being silently corrected by an unrelated operation.
    """
    for index in range(list_start - 1, -1, -1):
        if not lines[index].startswith("## "):
            continue
        match = _COUNT_RE.search(lines[index])
        if not match:
            return
        token = match.group(1)
        lowered = token.lower()
        value = int(lowered) if lowered.isdigit() else NUMBER_WORDS.index(lowered)
        if value != was:
            return
        if lowered.isdigit():
            replacement = str(now)
        elif now < len(NUMBER_WORDS):
            replacement = _match_case(token, NUMBER_WORDS[now])
        else:
            return
        lines[index] = lines[index][: match.start(1)] + replacement + lines[index][match.end(1):]
        return


def _list_block(lines: list, hole: int) -> tuple:
    start = hole
    while start > 0 and re.match(r"^\d+\. ", lines[start - 1]):
        start -= 1
    end = hole
    while end < len(lines) and re.match(r"^\d+\. ", lines[end]):
        end += 1
    return start, end


def _renumber_list(lines: list, hole: int) -> list:
    """Renumber the contiguous `N. ` block that used to contain `lines[hole]`."""
    start, end = _list_block(lines, hole)
    for offset, index in enumerate(range(start, end), start=1):
        lines[index] = re.sub(r"^\d+\. ", f"{offset}. ", lines[index])
    return lines


def _drop_index_bullet(path: Path, slugs: set) -> None:
    if not path.is_file():
        return
    lines = path.read_text(encoding="utf-8").split("\n")
    for index, line in enumerate(lines):
        if not any(f"#{slug})" in line for slug in slugs):
            continue
        start, end = _list_block(lines, index)
        _retitle_count(lines, start, end - start, end - start - 1)
        del lines[index]
        lines = _renumber_list(lines, index)
        break
    path.write_text("\n".join(lines), encoding="utf-8")


def _supersede_apply(topic: str, slug: str, adr_path: Path, note) -> None:
    core_path = board_path() / "core" / f"{topic}.md"
    found = _find_core_section(core_path, slug)
    if found is None:
        die(f"no section in core/{topic}.md matches '{slug}'; nothing changed")
    lines, start, end, heading = found
    section = lines[start:end]
    del lines[start:end]
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).rstrip("\n")
    core_path.write_text(text + "\n", encoding="utf-8")

    archive_path = board_path() / "archive" / f"{topic}.md"
    archive_path.parent.mkdir(parents=True, exist_ok=True)
    if not archive_path.is_file():
        archive_path.write_text(
            "<!-- Superseded rules, kept for the record. core/ holds only live rules. -->\n",
            encoding="utf-8",
        )
    existing = archive_path.read_text(encoding="utf-8").rstrip("\n")
    tombstone = _repair_fragments(
        _archive_body(
            heading, section, adr_path.name, note, datetime.now().strftime("%Y-%m-%d")
        ),
        _core_anchors(core_path),
        topic,
    )
    archive_path.write_text(existing + "\n\n" + tombstone + "\n", encoding="utf-8")

    index_path = board_path() / "core" / "INDEX.md"
    _drop_index_bullet(index_path, {_anchor(heading), _slug(heading)})


def cmd_supersede(args) -> None:
    _require_feature_branch(DEFAULT_REMOTE, "supersede")
    if args.topic not in CORE_TOPICS:
        die(f"--in must be one of {', '.join(CORE_TOPICS)}")
    adr_path = _find_adr(args.adr)
    if adr_path is None:
        die(
            f"no ADR {args.adr} in decisions/; a rule may only be superseded by a "
            f"decision that is already recorded",
        )
    sha = run_git("rev-parse", "HEAD").stdout.strip()
    tmp = board_path() / ".hivemind-tmp"
    try:
        tmp.mkdir(parents=True, exist_ok=True)
        _supersede_apply(args.topic, args.slug, adr_path, args.note)
        run_git("add", "-A")
        run_git(
            "commit",
            "-m", f"supersede: {args.slug} (ADR {args.adr} in {args.topic}.md)",
        )
        _set_upstream(DEFAULT_REMOTE)
        push_or_stop()
    except (Exception, SystemExit) as exc:
        reason = str(exc).strip() or "the supersession could not be completed"
        detail = ""
        try:
            _rollback(sha, tmp)
        except Exception as rollback_exc:
            detail = f" (rollback error: {rollback_exc})"
        die(f"supersede rolled back to {sha}; core untouched: {reason}{detail}", code=3)
    emit(f"superseded {args.slug} from core/{args.topic}.md into archive/{args.topic}.md")


def cmd_find(args) -> None:
    board = board_path()
    query = args.query.lower()
    hits = 0
    files = []
    for name in ("core", "stream"):
        folder = board / name
        if folder.is_dir():
            files.extend(sorted(folder.glob("*.md")))
    for path in files:
        text = path.read_text(encoding="utf-8", errors="replace")
        if query not in text.lower():
            continue
        hits += 1
        emit(str(path.relative_to(board)))
        try:
            meta, _ = _parse(text, str(path))
        except PostError:
            meta = None
        if meta:
            for key, value in meta.items():
                if isinstance(value, list):
                    emit(f"  {key}: {', '.join(str(item) for item in value)}")
                else:
                    emit(f"  {key}: {value}")
        for line in text.split("\n"):
            if query in line.lower():
                emit(f"  match: {line.strip()}")
                break
    if not hits:
        emit("no matches")


def cmd_pull(args) -> None:
    run_git("pull", "--rebase")
    emit("pulled")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hm", description="hivemind board CLI")
    sub = parser.add_subparsers(dest="command")

    pull = sub.add_parser("pull", help="fetch and rebase onto the remote")
    pull.set_defaults(func=cmd_pull)

    post = sub.add_parser("post", help="write a post, push it, and open/merge a PR")
    post.add_argument("--title", required=True)
    post.add_argument("--kind", required=True)
    post.add_argument("--topics", required=True, help="comma separated")
    post.add_argument("--projects", required=True, help="comma separated")
    post.add_argument("--body", default=None, help="'-' for stdin, or a file path")
    post.add_argument("--origin", default="gift", help="who is writing this post")
    post.add_argument("--remote", default="origin", help="git remote to push to")
    post.add_argument("--no-pr", action="store_true", help="push only; do not open a PR")
    post.add_argument(
        "--no-merge", action="store_true", help="open the PR but leave it for review"
    )
    post.set_defaults(func=cmd_post)

    merge = sub.add_parser("merge", help="merge open PRs with a rebase")
    merge.add_argument("targets", nargs="*", help="PR numbers or branches")
    merge.add_argument("--all", action="store_true", help="merge every open PR")
    merge.set_defaults(func=cmd_merge)

    status = sub.add_parser("status", help="board summary")
    status.set_defaults(func=cmd_status)

    endorse = sub.add_parser("endorse", help="endorse a post")
    endorse.add_argument("id")
    endorse.set_defaults(func=cmd_endorse)

    queue = sub.add_parser("queue", help="show the ratification queue")
    queue.set_defaults(func=cmd_queue)

    ratify = sub.add_parser("ratify", help="promote queued posts into core/")
    ratify.add_argument("id", nargs="?", default=None)
    ratify.add_argument("--all", action="store_true")
    ratify.add_argument("--core-file", default=None)
    ratify.set_defaults(func=cmd_ratify)

    supersede = sub.add_parser(
        "supersede", help="move a withdrawn rule out of core/ into archive/"
    )
    supersede.add_argument("--slug", required=True, help="section slug in the core file")
    supersede.add_argument("--in", dest="topic", required=True, help="core file name")
    supersede.add_argument(
        "--withdrawn-by", dest="adr", required=True,
        help="ADR number of the decision that withdrew the rule",
    )
    supersede.add_argument("--note", default=None, help="one line on why")
    supersede.set_defaults(func=cmd_supersede)

    find = sub.add_parser("find", help="search core/ and stream/")
    find.add_argument("query")
    find.set_defaults(func=cmd_find)

    return parser


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    parser = build_parser()
    if not argv:
        emit(parser.format_help().rstrip("\n"))
        return 0
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        emit(parser.format_help().rstrip("\n"))
        return 0
    try:
        args.func(args)
    except GitError as exc:
        die(str(exc), 1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
